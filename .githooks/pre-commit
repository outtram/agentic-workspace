#!/bin/bash
# Pre-commit hook: enforce documentation sync when Command Centre changes.
#
# Two checks:
# 1. If any brain/command_centre/ file is staged, docs must be updated too
# 2. If help_data.yml is staged, generated outputs must be in sync

STAGED=$(git diff --cached --name-only)

# ─── Check 1: CC changes require docs ───────────────────────────────
CC_CHANGED=false
for f in $STAGED; do
    case "$f" in
        brain/command_centre/*.py|brain/command_centre/handlers/*)
            CC_CHANGED=true
            break
            ;;
    esac
done

if [ "$CC_CHANGED" = true ]; then
    # At least one documentation file must also be staged
    DOCS_UPDATED=false
    for f in $STAGED; do
        case "$f" in
            HELP.md|\
            brain/command_centre/help_data.yml|\
            docs/ARCHITECTURE.md)
                DOCS_UPDATED=true
                break
                ;;
        esac
    done

    if [ "$DOCS_UPDATED" = false ]; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: CC files changed without documentation!       ║"
        echo "║                                                         ║"
        echo "║  Stage at least one of:                                 ║"
        echo "║    • HELP.md (run: python3 -m brain.command_centre.help_gen)"
        echo "║    • brain/command_centre/help_data.yml                 ║"
        echo "║    • docs/ARCHITECTURE.md                               ║"
        echo "║                                                         ║"
        echo "║  Or skip with: git commit --no-verify (not recommended) ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        exit 1
    fi
fi

# ─── Check 2: help_data.yml staged → generated outputs must be fresh ─
HELP_DATA_STAGED=false
for f in $STAGED; do
    if [ "$f" = "brain/command_centre/help_data.yml" ]; then
        HELP_DATA_STAGED=true
        break
    fi
done

if [ "$HELP_DATA_STAGED" = true ]; then
    if ! python3 -m brain.command_centre.help_gen --check 2>/dev/null; then
        echo ""
        echo "╔══════════════════════════════════════════════════════════╗"
        echo "║  BLOCKED: help_data.yml changed but outputs are stale!  ║"
        echo "║                                                         ║"
        echo "║  Run: python3 -m brain.command_centre.help_gen          ║"
        echo "║  Then stage: HELP.md + brain/command_centre/app.py      ║"
        echo "╚══════════════════════════════════════════════════════════╝"
        echo ""
        exit 1
    fi
fi

exit 0
