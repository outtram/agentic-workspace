# OutBot Configuration
# Copy to .env and fill in values

# Anthropic API key (optional - OutBot uses `claude` CLI with your Max plan)
# Only set this if you want to use the API directly instead
# ANTHROPIC_API_KEY=

# IPC socket path for WhatsApp bridge
OUTBOT_SOCKET_PATH=/tmp/outbot.sock

# SQLite database path
OUTBOT_DB_PATH=brain/store/outbot.db

# Quiet hours (no proactive notifications)
OUTBOT_QUIET_START=22
OUTBOT_QUIET_END=7

# Heartbeat interval in seconds (default 30 min)
OUTBOT_HEARTBEAT_INTERVAL=1800

# Troy's WhatsApp JID
OUTBOT_TROY_JID=

# --- Email Outbox ---
# Backend: 'console' (prints to log) or 'gmail' (sends via SMTP)
OUTBOT_EMAIL_BACKEND=console

# Gmail settings (only needed if backend=gmail)
# 1. Create/use a Gmail account
# 2. Enable 2-Step Verification
# 3. Generate App Password: Google Account > Security > App Passwords
OUTBOT_EMAIL_ADDRESS=
OUTBOT_EMAIL_APP_PASSWORD=

# Default recipient (your personal email)
OUTBOT_EMAIL_DEFAULT_TO=
